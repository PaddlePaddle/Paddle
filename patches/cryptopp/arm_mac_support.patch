--- a/cmake/external/cryptopp.cmake
+++ b/cmake/external/cryptopp.cmake
@@ -42,8 +42,15 @@ else()
       CACHE FILEPATH "cryptopp library." FORCE)
 endif()
 
-if(APPLE AND WITH_ARM)
-  set(CMAKE_CXX_FLAGS "-DCRYPTOPP_ARM_CRC32_AVAILABLE=0")
+# Crypto++ 8.9.0+ has native Mac M1/M2 support
+# Add ARM-specific compiler flags for Mac M1/M2
+if(APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|ARM64")
+    set(CRYPTOPP_ARM_FLAGS "-march=armv8-a+crc+crypto")
+    set(CRYPTOPP_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${CRYPTOPP_ARM_FLAGS}")
+    set(CRYPTOPP_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} ${CRYPTOPP_ARM_FLAGS}")
+else()
+    set(CRYPTOPP_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
+    set(CRYPTOPP_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE}")
 endif()
 
 set(CRYPTOPP_CMAKE_ARGS
@@ -54,8 +61,8 @@ set(CRYPTOPP_CMAKE_ARGS
     -DCMAKE_INSTALL_LIBDIR=${CRYPTOPP_INSTALL_DIR}/lib
     -DCMAKE_INSTALL_PREFIX=${CRYPTOPP_INSTALL_DIR}
     -DCMAKE_BUILD_TYPE=${THIRD_PARTY_BUILD_TYPE}
-    -DCMAKE_CXX_FLAGS=${CMAKE_CXX_FLAGS}
-    -DCMAKE_CXX_FLAGS_RELEASE=${CMAKE_CXX_FLAGS_RELEASE}
+    -DCMAKE_CXX_FLAGS=${CRYPTOPP_CXX_FLAGS}
+    -DCMAKE_CXX_FLAGS_RELEASE=${CRYPTOPP_CXX_FLAGS_RELEASE}
     -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
     -DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER})
