--- a/cmake/hip.cmake
+++ b/cmake/hip.cmake
@@ -11,8 +11,25 @@ else()
     set(HIP_PATH ${ROCM_PATH}/hip CACHE PATH "Path to which HIP has been installed")
     set(HIP_CLANG_PATH ${ROCM_PATH}/llvm/bin CACHE PATH "Path to which clang has been installed")
 endif()
-set(CMAKE_MODULE_PATH "${HIP_PATH}/cmake" ${CMAKE_MODULE_PATH})
+# ROCm HIP CMake modules can live in different places across versions/images.
+# Prefer the new unified path, but also keep the legacy hip/cmake path so that
+# include(UseHIP) can be resolved when it is not shipped under lib/cmake/hip.
+if(IS_DIRECTORY "${ROCM_PATH}/lib/cmake/hip")
+  set(CMAKE_MODULE_PATH "${ROCM_PATH}/lib/cmake/hip" ${CMAKE_MODULE_PATH})
+endif()
+if(IS_DIRECTORY "${ROCM_PATH}/hip/cmake")
+  set(CMAKE_MODULE_PATH "${ROCM_PATH}/hip/cmake" ${CMAKE_MODULE_PATH})
+endif()
+if(IS_DIRECTORY "${HIP_PATH}/cmake")
+  set(CMAKE_MODULE_PATH "${HIP_PATH}/cmake" ${CMAKE_MODULE_PATH})
+endif()
+
 find_package(HIP REQUIRED)
+# HIP_ADD_LIBRARY / hip_add_library macros are provided by UseHIP in some ROCm
+# layouts. Guard it to avoid hard failure if the module is not shipped.
+if(EXISTS "${ROCM_PATH}/hip/cmake/UseHIP.cmake" OR EXISTS "${ROCM_PATH}/lib/cmake/hip/UseHIP.cmake" OR EXISTS "${HIP_PATH}/cmake/UseHIP.cmake")
+  include(UseHIP)
+endif()
 include_directories(${ROCM_PATH}/include)
 message(STATUS "HIP version: ${HIP_VERSION}")
 message(STATUS "HIP_CLANG_PATH: ${HIP_CLANG_PATH}")
@@ -76,5 +90,5 @@ endif()
 message(STATUS "HIP library name: ${hip_library_name}")
 
 # set HIP link libs
-find_library(ROCM_HIPRTC_LIB ${hip_library_name} HINTS ${HIP_PATH}/lib)
+find_library(ROCM_HIPRTC_LIB ${hip_library_name} HINTS ${ROCM_PATH}/lib ${ROCM_PATH}/lib64 ${HIP_PATH}/lib)
 message(STATUS "ROCM_HIPRTC_LIB: ${ROCM_HIPRTC_LIB}")
